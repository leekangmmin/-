<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  codesign/notarization 준비용 entitlements 초안이다. Apple Developer 인증서가
  없는 현재 단계에서는 사용되지 않는다 (unsigned internal alpha).
  이 앱은 loopback(127.0.0.1)에서만 서버를 열지만, App Sandbox 하에서는
  loopback 리스닝 소켓도 network.server 권한이 필요하므로 이를 허용한다.
  외부 네트워크로 나가는 연결은 사용하지 않지만 향후 Cloud AI(Claude) 호출을
  대비해 network.client도 허용해 둔다 — 두 권한 모두 App Sandbox를 켤 때만
  의미가 있으며, 현재(app-sandbox=false)는 적용되지 않는다.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <false/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
